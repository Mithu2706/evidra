# Copy to .env (repository root) and adjust. All values are read by the backend only;
# nothing here is ever sent to the browser.

EVIDRA_ENV=development
EVIDRA_SECRET_KEY=change-me-to-a-long-random-string
# EVIDRA_DATABASE_URL=sqlite:///./backend/data/evidra.db
# EVIDRA_STORAGE_DIR=./backend/data/storage
EVIDRA_AUTO_SEED=true
EVIDRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI analysis --------------------------------------------------------------
# heuristic : offline rule-based analyzer (default, no API key, no model calls)
# anthropic : Claude via the Anthropic API
EVIDRA_AI_ENGINE=heuristic
# ANTHROPIC_API_KEY=sk-ant-...
EVIDRA_ANTHROPIC_MODEL=claude-opus-5-5
EVIDRA_ANTHROPIC_EFFORT=high
# Re-run a declined request on Anthropic's recommended fallback model.
EVIDRA_ANTHROPIC_FALLBACKS=true

# --- Ingestion ----------------------------------------------------------------
# auto | rapidocr | tesseract | none
EVIDRA_OCR_ENGINE=auto
# Path to LibreOffice `soffice` if it is not on PATH (needed to render PPTX slides).
# EVIDRA_LIBREOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
EVIDRA_RENDER_WIDTH_PX=1600
EVIDRA_PROCESSING_WORKERS=2
